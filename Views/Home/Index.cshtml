@model EmployeeWebApplication.Models.EmployeeDataViewModel

@{
    ViewData["Title"] = "Employees";
}

<h1>Employees</h1>

<p>
    <a asp-action="Employees" class="btn btn-primary">View Employee Database</a>
</p>

<hr />

<h3>Search Employees</h3>

<form asp-controller="Home" asp-action="Search" method="post">

    <label for="search-name">First Name:</label>
    <input class="form-control" type="text" id="search-name" name="name">
    <br>

    <label for="search-department">Department:</label>
    <input class="form-control" type="text" id="search-department" name="department">
    <br>

    <button type="submit" class="btn btn-primary">
        Search
    </button>

    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        Clear
    </a>

</form>

@if (Model.HasSearched)
{
    if (Model.SearchResults.Count == 0)
    {
        <p class="text-danger">No employees were found.</p>
    }
    else
    {
        <p>Search results:</p>

        foreach (var employee in Model.SearchResults)
        {
            <p>
                @employee.EmployeeId -
                @employee.FirstName @employee.LastName -
                @employee.Email -
                @employee.Department
            </p>
        }
    }
}


<hr />

<h3>Create Employee</h3>

<p>
    <a asp-action="CreateView" class="btn btn-danger">View Employee Database</a>
</p>

<hr />

<h3>Update Employee</h3>

<p>
    <a asp-controller="Home" asp-action="UpdateView" class="btn btn-secondary">Go to Update Page</a>
</p>


<hr />
<h3>Delete Employee</h3>

<div class="delete-employees">
    <form asp-controller="Home" asp-action="Delete" method="post"
          onsubmit="return confirm('Are you sure you want to delete this employee?');">

        <label for="delete-id">Employee ID:</label>
        <input type="number" id="delete-id" name="employeeId">
        <br>

        <button type="submit" class="btn btn-danger">
            Delete Employee
        </button>

    </form>
</div>

<hr />

<h3>CSV Functionality</h3> <br />
<h5>1. Export all Data to CSV</h5>

<a asp-controller="Home" asp-action="ExportCsv" class="btn btn-success">Export to CSV</a>

<br />
<br />

<h5>2. Import all Data from CSV</h5>

<form asp-controller="Home" asp-action="ImportCsv" method="post" enctype="multipart/form-data">
    <div class="import-csv">
        <label for="file">Import CSV:</label>
        <input type="file" name="file" class="form-control" accept=".csv" /> @*make sure it only accepts CSV files*@
    </div>

    <button type="submit" class="btn btn-info">Upload</button>
</form>