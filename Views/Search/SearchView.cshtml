@model EmployeeWebApplication.Models.EmployeeDataViewModel

@{
    ViewData["Title"] = "Search";
}


<h3>Search Employees</h3>

<form asp-controller="Search" asp-action="Search" method="post">

    <label for="search-name">Name:</label>
    <input class="form-control" type="text" id="search-name" name="name">
    <br>

    <label for="search-department">Department:</label>
    <input class="form-control" type="text" id="search-department" name="department">
    <br>

    <button type="submit" class="btn btn-primary">
        Search
    </button>

    <a asp-controller="Search" asp-action="SearchView" class="btn btn-secondary">
        Clear
    </a>

</form>

@if (Model.HasSearched)
{
    if (Model.SearchResults.Count == 0)
    {
        @*here the error message will show, but it's declared in the search controller' *@
        @*this also makes sure that the table doesn't show at the bottom  *@
    }
    else
    {
        <p>Search results:</p>

        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Date created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employee in Model.SearchResults)
                    {
                        <tr>
                            <td>@employee.EmployeeId</td>
                            <td>@employee.FirstName @employee.LastName</td>
                            <td>@employee.Email</td>
                            <td>@employee.Department</td>
                            <td>@employee.DateCreated.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
