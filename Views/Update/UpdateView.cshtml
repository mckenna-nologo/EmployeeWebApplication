@model EmployeeWebApplication.Models.EmployeeDataViewModel

@{
    ViewData["Title"] = "Update Employee";
}

<h3>Update Employee</h3>

<p>Enter the ID of the employee you want to change.</p>

<form asp-controller="Update" asp-action="FindEmployee" method="post">
    <label>Employee ID:</label>
    <input type="number" name="employeeId" class="form-control" />
    
    <br />

    <button type="submit" class="btn btn-primary">Find Employee</button>
</form>

<br />

@if (!string.IsNullOrEmpty(Model.ErrorMessage)) //set in thecontroller -> if the error message contains text, show it
{ 
    <p class="text-danger"> @Model.ErrorMessage </p>
}


@if (Model.SelectedEmployee != null) @*only show update form if the employee was found*@
{
    <hr />

    <p>This is the employee we are updating:</p>

    <p>
        <strong>
            @Model.SelectedEmployee.EmployeeId - @Model.SelectedEmployee.FirstName @Model.SelectedEmployee.LastName | @Model.SelectedEmployee.Email | @Model.SelectedEmployee.Department
        </strong>
    </p>  

    <p>Change the details below:</p>

    <form asp-controller="Update" asp-action="Update" method="post"> 

        <input asp-for="SelectedEmployee.EmployeeId" type="hidden" /> @* keep id*@

        <label>First name:</label>
        <input asp-for="SelectedEmployee.FirstName" class="form-control" />
        <span asp-validation-for="SelectedEmployee.FirstName" class="text-danger"></span> @*validation message *@

        <br />

        <label>Last name:</label>
        <input asp-for="SelectedEmployee.LastName" class="form-control" />
        <span asp-validation-for="SelectedEmployee.LastName" class="text-danger"></span> 

        <br />

        <label>Email:</label>
        <input asp-for="SelectedEmployee.Email" class="form-control" />
        <span asp-validation-for="SelectedEmployee.Email" class="text-danger"></span>

        <br />

        <label>Department:</label>
        <input asp-for="SelectedEmployee.Department"class="form-control" />
        <span asp-validation-for="SelectedEmployee.Department" class="text-danger"></span>
        
        <br />

        <button type="submit" class="btn btn-primary">Update Employee</button>
    </form>

}


@section Scripts
{
    @*loads the javascritp for the validation message*@

    <partial name="_ValidationScriptsPartial" /> @*https: //learn.microsoft.com/en-us/aspnet/core/mvc/views/layout?view=aspnetcore-10.0*@
}