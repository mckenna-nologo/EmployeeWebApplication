@model EmployeeWebApplication.Models.EmployeeDataViewModel

@{
    ViewData["Title"] = "Employees";
}

<h1>Employees</h1>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Date created</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var employee in Model.Employees)
            {
                <tr>
                    <td>@employee.EmployeeId</td>
                    <td>@employee.FirstName @employee.LastName</td>
                    <td>@employee.Email</td>
                    <td>@employee.Department</td>
                    <td>@employee.DateCreated.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<hr />

<h3>Search Employees</h3>

<form asp-controller="Home" asp-action="Search" method="post">

    <label for="search-name">First Name:</label>
    <input type="text" id="search-name" name="name">
    <br>

    <label for="search-department">Department:</label>
    <input type="text" id="search-department" name="department">
    <br>

    <button type="submit" class="btn btn-primary">
        Search
    </button>

    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        Clear
    </a>

</form>

@if (Model.HasSearched)
{
    if (Model.SearchResults.Count == 0)
    {
        <p class="text-danger">No employees were found.</p>
    }
    else
    {
        <p>Search results:</p>

        foreach (var employee in Model.SearchResults)
        {
            <p>
                @employee.EmployeeId -
                @employee.FirstName @employee.LastName -
                @employee.Email -
                @employee.Department
            </p>
        }
    }
}


<hr />

<h3>Create Employee</h3>

<div class="create-employees">
    <form asp-controller="Home" asp-action="Create" method="post">
        <label for="create-firstname">First name:</label>
        <input type="text" id="create-firstname" name="FirstName">
        <br>

        <label for="create-lastname">Last name:</label>
        <input type="text" id="create-lastname" name="LastName">
        <br>

        <label for="create-email">Email:</label>
        <input type="email" id="create-email" name="Email">
        <br>

        <label for="create-department">Department:</label>
        <input type="text" id="create-department" name="Department">
        <br>

        <button type="submit" class="btn btn-primary">
            Create Employee
        </button>
    </form>
</div>

<hr />

<h3>Update Employee</h3>

<p class="text-muted">Enter the ID of the employee you want to change.</p>

<div class="update-employees">
    <form asp-controller="Home" asp-action="FindEmployee" method="post">
        <label for="update-id">Employee ID:</label>
        <input type="number" id="update-id" name="employeeId">

        <button type="submit" class="btn btn-secondary">
            Find Employee
        </button>
    </form>



    @if (Model.SelectedEmployee != null)
    {
        <hr />
        <p>This is the current employee we're updating:</p>
        <p><strong> @Model.SelectedEmployee.EmployeeId - @Model.SelectedEmployee.FirstName @Model.SelectedEmployee.LastName | @Model.SelectedEmployee.Email | @Model.SelectedEmployee.Department</strong></p>

        <p class="text-muted">Fill in the updated details below.</p>

        <form asp-controller="Home" asp-action="Update" method="post">
            <input type="hidden"
                   name="EmployeeId"
                   value="@Model.SelectedEmployee.EmployeeId">

            <label for="update-firstname">First name:</label>
            <input type="text"
                   id="update-firstname"
                   name="FirstName"
                   value="@Model.SelectedEmployee.FirstName">
            <br>

            <label for="update-lastname">Last name:</label>
            <input type="text"
                   id="update-lastname"
                   name="LastName"
                   value="@Model.SelectedEmployee.LastName">
            <br>

            <label for="update-email">Email:</label>
            <input type="email"
                   id="update-email"
                   name="Email"
                   value="@Model.SelectedEmployee.Email">
            <br>

            <label for="update-department">Department:</label>
            <input type="text"
                   id="update-department"
                   name="Department"
                   value="@Model.SelectedEmployee.Department">
            <br>

            <button type="submit" class="btn btn-primary">
                Update Employee
            </button>
        </form>
    }
</div>


<hr />
<h3>Delete Employee</h3>

<div class="delete-employees">
    <form asp-controller="Home" asp-action="Delete" method="post"
          onsubmit="return confirm('Are you sure you want to delete this employee?');">

        <label for="delete-id">Employee ID:</label>
        <input type="number" id="delete-id" name="employeeId">
        <br>

        <button type="submit" class="btn btn-danger">
            Delete Employee
        </button>

    </form>
</div>

<hr />
<h5>Export all Data to CSV</h5>

<a asp-controller="Home" asp-action="ExportCsv" class="btn btn-success">
    Export to CSV
</a>