@model EmployeeWebApplication.Models.EmployeeDataViewModel

@{
    ViewData["Title"] = "Delete Employees";
}

<h3>Delete Employees</h3>

<p class="text-muted">Enter the ID of the employee you want to change.</p>

<div class="delete-employees">
    <form asp-controller="Delete" asp-action="FindEmployee" method="post">
        @Html.AntiForgeryToken()
        <label for="delete-id">Employee ID:</label>
        <input class="form-control" type="number" id="delete-id" name="employeeId" required />
        <br />
        <button type="submit" class="btn btn-primary">
            Find Employee
        </button>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="text-danger">@Model.ErrorMessage</div>
    }

    @if (Model?.SelectedEmployee != null)
    {
        <hr />
        <p>Are you sure you want to delete this employee:</p>
        <p><strong> @Model.SelectedEmployee.EmployeeId - @Model.SelectedEmployee.FirstName @Model.SelectedEmployee.LastName | @Model.SelectedEmployee.Email | @Model.SelectedEmployee.Department</strong></p>

        <form asp-controller="Delete" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="employeeId" value="@Model.SelectedEmployee.EmployeeId" />
            <button type="submit" class="btn btn-danger">
                Delete Employee
            </button>
        </form>
    }
</div>