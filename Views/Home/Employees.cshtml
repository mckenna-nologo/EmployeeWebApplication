@model EmployeeWebApplication.Models.EmployeeDataViewModel
@{
    ViewData["Title"] = "Employee Database";
}

<h3>Employee Database</h3>

@{
    var sf = (ViewBag.SortField ?? "").ToString(); //use sortfield, but if it is null, use an empty string instead
    var sd = (ViewBag.SortDir ?? "asc").ToString(); //use sortdir, but if it's null, use ascending --> direction
}

<div class="mb-3"> @*margin class*@
    <form asp-action="Employees" method="get" class="row g-2 align-items-center">
        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />

        @*filter*@
        <div class="col-auto">
            <label class="visually-hidden" for="filter">Filter</label>
            <input class="form-control" type="search" id="filter" name="filter" placeholder="Search" value="@ViewBag.Filter" />
        </div>

        @*status filter*@
<script>
    (function(){
        try {
            var sf = '@sf';
            var sd = '@sd';
            var st = '@(ViewBag.StatusFilter ?? "all")';
            var fil = '@(ViewBag.Filter ?? "")';

            var elSf = document.getElementById('sort-field');
            if (elSf) elSf.value = sf || '';
            var elSd = document.getElementById('sort-dir');
            if (elSd) elSd.value = sd || 'asc';
            var elSt = document.getElementById('status-filter');
            if (elSt) elSt.value = st || 'all';
            var elFil = document.getElementById('filter');
            if (elFil) elFil.value = fil || '';
        } catch(e) { /* ignore */ }
    })();
</script>
        <div class="col-auto">
            <label class="visually-hidden" for="status-filter">Status</label>
            <select class="form-select" id="status-filter" name="statusFilter">
                <option value="all">Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>

        @*sort fields*@
        <div class="col-auto">
            <label class="visually-hidden" for="sort-field">Sort by</label>
            <select class="form-select" id="sort-field" name="sortField">
                <option value="">ID</option>
                <option value="first">First Name</option>
                <option value="last">Last Name</option>
                <option value="email">Email</option>
                <option value="department">Department</option>
                <option value="date">Date Created</option>
            </select>
        </div>

        @*sort direction*@
        <div class="col-auto">
            <label class="visually-hidden" for="sort-dir">Direction</label>
            <select class="form-select" id="sort-dir" name="sortDir">
                <option value="asc">Ascending</option>
                <option value="desc">Descending</option>
            </select>
        </div>

        @*buttons*@
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Employees" class="btn btn-secondary ms-2">Clear</a>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Status</th>
                <th>Department</th>
                <th>Date created</th>
            </tr>

        </thead>

        <tbody>
            @foreach (var employee in Model.Employees)
            {
                <tr>
                    <td>@employee.EmployeeId</td>
                    <td>@employee.FirstName</td>
                    <td>@employee.LastName</td>
                    <td>@employee.Email</td>
                    <td>
                        @if (employee.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>@employee.Department</td>
                    <td>@employee.DateCreated.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* pagination *@
@if (Model.TotalPages > 1)
{
    <nav aria-label="Employee pagination">
        <ul class="pagination">
            @{
                var current = Model.PageNumber <= 0 ? 1 : Model.PageNumber;
                var total = Model.TotalPages;
            }

            <li class="page-item @(current == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Employees" asp-route-page="@(current - 1)" asp-route-pageSize="@Model.PageSize" asp-route-sortField="@sf" asp-route-sortDir="@sd" asp-route-filter="@ViewBag.Filter">Previous</a>
            </li>

            @for (int i = 1; i <= total; i++)
            {
                <li class="page-item @(i == current ? "active" : "")">
                    <a class="page-link" asp-action="Employees" asp-route-page="@i" asp-route-pageSize="@Model.PageSize" asp-route-sortField="@sf" asp-route-sortDir="@sd" asp-route-filter="@ViewBag.Filter">@i</a>
                </li>
            }

            <li class="page-item @(current == total ? "disabled" : "")">
                <a class="page-link" asp-action="Employees" asp-route-page="@(current + 1)" asp-route-pageSize="@Model.PageSize" asp-route-sortField="@sf" asp-route-sortDir="@sd" asp-route-filter="@ViewBag.Filter">Next</a>
            </li>
        </ul>
    </nav>
}